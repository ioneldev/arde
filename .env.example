# Copy to .env and fill in. docker compose run reads it, and so does uv run --env-file .env arde ...
ANTHROPIC_API_KEY=
# Optional: where workspaces and runs live. Default ~/.arde. The container keeps them in its volume.
# ARDE_HOME=
# Optional: the local repo `docker compose run --rm arde` documents, mounted read-only. Empty means none.
REPO_PATH=
# Optional, on a Linux host: your `id -u` and `id -g`, so ARDE can read files only you can read.
ARDE_UID=
ARDE_GID=
# Optional: the author of the commit a URL run makes. ARDE stays its committer.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
